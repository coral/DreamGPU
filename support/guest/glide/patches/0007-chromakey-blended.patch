+// Voodoo hardware discards chroma-keyed pixels in every blend mode. OpenGLide
+// gives keyed texels texture alpha 0 and alpha-tests a draw whose vertex alpha
+// is 1, which replaces the fragment alpha. That is only invisible when nothing
+// reads the fragment alpha: blending off, or blend factors that never use the
+// source alpha while alpha writes are off (glBlendFunc also blends alpha).
+static bool KeyedAlphaUnused( void )
+{
+    if ( !OpenGL.Blend )
+    {
+        return true;
+    }
+    if ( Glide.State.AlphaMask )
+    {
+        return false;
+    }
+    switch ( OpenGL.SrcBlend )
+    {
+    case GL_ZERO: case GL_ONE: case GL_DST_COLOR: case GL_ONE_MINUS_DST_COLOR:
+    case GL_DST_ALPHA: case GL_ONE_MINUS_DST_ALPHA:
+        break;
+    default:
+        return false;
+    }
+    switch ( OpenGL.DstBlend )
+    {
+    case GL_ZERO: case GL_ONE: case GL_SRC_COLOR: case GL_ONE_MINUS_SRC_COLOR:
+    case GL_DST_ALPHA: case GL_ONE_MINUS_DST_ALPHA:
+        return true;
+    default:
+        return false;
+    }
+}
