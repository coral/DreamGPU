+static void RestoreDisplay(void)
+{
+    if ( mode_changed )
+    {
+        ResetScreenMode( );
+        mode_changed = false;
+    }
+    if ( saved_hwnd && IsWindow( saved_hwnd ) )
+    {
+        SetWindowLong( saved_hwnd, GWL_STYLE, saved_style );
+        SetWindowPos( saved_hwnd, NULL, saved_rect.left, saved_rect.top,
+                      saved_rect.right - saved_rect.left, saved_rect.bottom - saved_rect.top,
+                      SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED );
+    }
+    saved_hwnd = NULL;
+}
 
