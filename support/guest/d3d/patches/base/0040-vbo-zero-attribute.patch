--- a/wined3d/drawprim.c
+++ b/wined3d/drawprim.c
@@ -705,7 +705,11 @@
     {
     	return;
     }
-    device->czvDrawVertices = index_count;
+    /* DreamGPU: the zero attribute must cover every vertex the draw reaches,
