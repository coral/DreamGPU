+/* DreamGPU: native Direct3D draws the part of its cursor inside the back
+ * buffer when the cursor crosses an edge (as later Wine does with
+ * wined3d_clip_blit). wined3d_surface_blt rejects a destination outside the
+ * surface (WINEDDERR_INVALIDRECT), so the whole cursor vanished there (0061).
+ * The cursor is drawn unscaled: each clipped destination edge moves the
+ * source edge by the same amount. FALSE when nothing is left. */
+static BOOL dg_swapchain_clip_cursor(LONG width, LONG height, RECT *dst, RECT *src)
+{
+    if (dst->left < 0)
+    {
+        src->left -= dst->left;
+        dst->left = 0;
+    }
+    if (dst->top < 0)
+    {
+        src->top -= dst->top;
+        dst->top = 0;
+    }
+    if (dst->right > width)
+    {
+        src->right -= dst->right - width;
+        dst->right = width;
+    }
+    if (dst->bottom > height)
+    {
+        src->bottom -= dst->bottom - height;
+        dst->bottom = height;
+    }
+    return dst->left < dst->right && dst->top < dst->bottom;
+}
+
