+/* DreamGPU: GL_POINT_SPRITE_COORD_ORIGIN is GL 2.0 state, so Wine sets it only
+ * there. Offscreen rendering (every target with framebuffer objects) is
+ * flipped vertically, and without the origin every point sprite texture comes
+ * out upside down. A GL below 2.0 may still take it through the scalar
+ * ARB_point_parameters entry point; ask once whether it does. */
+/* Context activation is done by the caller. */
+static BOOL wined3d_check_point_sprite_origin(const struct wined3d_gl_info *gl_info)
+{
+    unsigned int i;
+    BOOL supported;
+
+    if (gl_info->supported[WINED3D_GL_VERSION_2_0] || !gl_info->supported[ARB_POINT_SPRITE]
+            || !gl_info->gl_ops.ext.p_glPointParameterfARB)
+        return FALSE;
+
+    for (i = 0; i < 16 && gl_info->gl_ops.gl.p_glGetError() != GL_NO_ERROR; ++i) {}
+    if (i == 16)
+        return FALSE;
+    GL_EXTCALL(glPointParameterfARB(GL_POINT_SPRITE_COORD_ORIGIN, (GLfloat)GL_LOWER_LEFT));
+    supported = gl_info->gl_ops.gl.p_glGetError() == GL_NO_ERROR;
+    /* Leave the GL default: contexts set the origin with their first draw. */
+    if (supported)
+        GL_EXTCALL(glPointParameterfARB(GL_POINT_SPRITE_COORD_ORIGIN, (GLfloat)GL_UPPER_LEFT));
+    for (i = 0; i < 16 && gl_info->gl_ops.gl.p_glGetError() != GL_NO_ERROR; ++i) {}
+    TRACE("Point sprite coordinate origin through glPointParameterfARB: %s.\n", supported ? "yes" : "no");
+
+    return supported;
+}
+
 /* Context activation is done by the caller. */
