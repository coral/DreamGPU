 {
+    const struct wined3d_gl_info *gl_info = context->gl_info;
     static BOOL warned;
 
+    /* DreamGPU: below GL 2.0 the scalar ARB entry point may take the origin
+     * (wined3d_check_point_sprite_origin()); keep psorigin()'s orientation. */
+    if (gl_info->point_sprite_origin_arb)
+    {
+        GL_EXTCALL(glPointParameterfARB(GL_POINT_SPRITE_COORD_ORIGIN,
+                (GLfloat)(context->render_offscreen ? GL_LOWER_LEFT : GL_UPPER_LEFT)));
+        checkGLcall("glPointParameterfARB(GL_POINT_SPRITE_COORD_ORIGIN, ...)");
+        return;
+    }
+
     if (!warned)
     {
         WARN("Point sprite coordinate origin switching not supported.\n");
