+/* Pointer equality alone is insufficient: a context may be rebound to another
+ * drawable, or its render target may change while sharing the physical depth. */
+BOOL device_owns_backbuffer_ds(const struct wined3d_device *device,
+        const struct wined3d_context *context, const struct wined3d_surface *surface)
+{
+    return context && context->valid && context->current_rt
+            && device->onscreen_depth_stencil == surface
+            && device->backbuffer_ds_context == context
+            && device->backbuffer_ds_rt == context->current_rt
+            && device->backbuffer_ds_hdc == context->hdc
+            && device->backbuffer_ds_glctx == context->glCtx;
+}
+
+HRESULT device_preserve_backbuffer_ds(struct wined3d_device *device, struct wined3d_context *context)
+{
+    struct wined3d_surface *old = device->onscreen_depth_stencil;
+    HRESULT hr;
+
+    if (!old) return WINED3D_OK;
+    surface_prepare_map_memory(old);
+    /* surface_load_location accepts an already valid CPU copy independently of
+     * the current drawable. GPU-only copies require the exact recorded owner. */
+    if (FAILED(hr = surface_load_location(old, context, old->resource.map_binding))) return hr;
+    surface_modify_ds_location(old, old->resource.map_binding,
+            old->ds_current_size.cx, old->ds_current_size.cy);
+    return WINED3D_OK;
+}
