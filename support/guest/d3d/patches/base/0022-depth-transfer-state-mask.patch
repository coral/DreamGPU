+     * only the groups this transfer changes, using their stable GL1.1 bits. */
+    gl_info->gl_ops.gl.p_glPushAttrib(GL_CURRENT_BIT | GL_PIXEL_MODE_BIT | GL_DEPTH_BUFFER_BIT
+            | GL_STENCIL_BUFFER_BIT | GL_ENABLE_BIT | GL_COLOR_BUFFER_BIT
+            | GL_VIEWPORT_BIT | GL_TRANSFORM_BIT);
     if ((error = gl_info->gl_ops.gl.p_glGetError()) != GL_NO_ERROR) goto cleanup;
     attrib = TRUE;
     gl_info->gl_ops.gl.p_glPushClientAttrib(GL_CLIENT_PIXEL_STORE_BIT);
