--- a/wined3d/surface.c
+++ b/wined3d/surface.c
@@ -4155,7 +4155,12 @@
      * dead transport that continually reports an error. */
     for (i = 0; i < 16 && gl_info->gl_ops.gl.p_glGetError() != GL_NO_ERROR; ++i) {}
