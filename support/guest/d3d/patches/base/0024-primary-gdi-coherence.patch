  * applications from drawing to the screen while we've locked the frontbuffer.
  * We'd like to do this in wined3d instead, but for that to work wined3d needs
  * to support windowless rendering first. */
+static HRESULT ddraw_surface_copy_screen(struct wined3d_surface *surface,
+        struct ddraw_palette *palette, int x, int y, int w, int h, BOOL read)
+{
+    HDC surface_dc, screen_dc;
+    HRESULT hr;
+    BOOL ret;
+
+    if (FAILED(hr = wined3d_surface_getdc(surface, &surface_dc)))
+        return hr;
+    if (palette)
+        wined3d_palette_apply_to_dc(palette->wineD3DPalette, surface_dc);
+    if (!(screen_dc = GetDC(NULL)))
+    {
+        wined3d_surface_releasedc(surface, surface_dc);
+        return E_FAIL;
+    }
+
+    if (read)
+        ret = BitBlt(surface_dc, x, y, w, h, screen_dc, x, y, SRCCOPY);
+    else
+        ret = BitBlt(screen_dc, x, y, w, h, surface_dc, x, y, SRCCOPY);
+    ReleaseDC(NULL, screen_dc);
+    hr = wined3d_surface_releasedc(surface, surface_dc);
+    return ret ? hr : E_FAIL;
+}
