+/* DreamGPU: whether a rectangle texture can hold a resource of this format and
+ * usage, by the checks resource_init() applies to every type and the texture
+ * check this tree disables there. */
+static BOOL resource_rect_usable(const struct wined3d_format *format, DWORD usage)
+{
+    DWORD flags = format->flags[WINED3D_GL_RES_TYPE_TEX_RECT];
+
+    if (!(flags & WINED3DFMT_FLAG_TEXTURE))
+        return FALSE;
+    if ((usage & WINED3DUSAGE_RENDERTARGET) && !(flags & WINED3DFMT_FLAG_RENDERTARGET))
+        return FALSE;
+    if ((usage & WINED3DUSAGE_DEPTHSTENCIL) && !(flags & (WINED3DFMT_FLAG_DEPTH | WINED3DFMT_FLAG_STENCIL)))
+        return FALSE;
+    if (wined3d_settings.offscreen_rendering_mode == ORM_FBO
+            && usage & (WINED3DUSAGE_RENDERTARGET | WINED3DUSAGE_DEPTHSTENCIL)
+            && !(flags & WINED3DFMT_FLAG_FBO_ATTACHABLE))
+        return FALSE;
+    return TRUE;
+}
