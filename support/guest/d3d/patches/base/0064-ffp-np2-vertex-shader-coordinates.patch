+/* DreamGPU: the coordinate scales of the fixed-function replacement program's
+ * vs_np2_fixup stages, the pow2_matrix factors the texture matrix applies
+ * without a vertex shader (0064). Program locals: environment parameters
+ * alias the application's c# constants. */
+static void arbfp_load_np2_fixup(const struct wined3d_gl_info *gl_info,
+        const struct wined3d_state *state, WORD stages)
+{
+    unsigned int stage;
+
+    for (stage = 0; stages; stages >>= 1, ++stage)
+    {
+        const struct wined3d_texture *texture = state->textures[stage];
+        GLfloat scale[4];
+
+        if (!(stages & 1) || !texture)
+            continue;
+        scale[0] = texture->pow2_matrix[0];
+        scale[1] = texture->pow2_matrix[5];
+        scale[2] = 1.0f;
+        scale[3] = 1.0f;
+        GL_EXTCALL(glProgramLocalParameter4fvARB(GL_FRAGMENT_PROGRAM_ARB, stage, scale));
+    }
+    checkGLcall("Load fixed-function NP2 coordinate scales");
+}
+
