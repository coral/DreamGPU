--- a/wined3d/directx.c
+++ b/wined3d/directx.c
@@ -994,9 +994,15 @@
      *  This fixup removes performance problems on both the FX 5900 and FX 5700 (e.g. for framebuffer
      *  post-processing effects in the game "Max Payne 2").
      *  The behaviour can be verified through a simple test app attached in bugreport #14724. */
+    /* DreamGPU: any DX9-level GL with an unrecognized vendor is reported as
+     * the fallback GeForce FX 5800, so this also matches implementations
+     * without either extension. Rectangles come back only if the driver
+     * reported them, and without NPOT there is nothing to remove. */
+    if (!gl_info->supported[ARB_TEXTURE_NON_POWER_OF_TWO])
+        return;
     TRACE("GL_ARB_texture_non_power_of_two advertised through OpenGL 2.0 on NV FX card, removing.\n");
     gl_info->supported[ARB_TEXTURE_NON_POWER_OF_TWO] = FALSE;
-    gl_info->supported[ARB_TEXTURE_RECTANGLE] = TRUE;
+    gl_info->supported[ARB_TEXTURE_RECTANGLE] = gl_info->texture_rectangle_hidden;
 }
 
