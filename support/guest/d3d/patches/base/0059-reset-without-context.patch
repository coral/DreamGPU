+/* DreamGPU: a state reset destroys every GL context before it creates the
+ * primary one again, and reads managed and implicit contents back through the
+ * current one first. Without a usable context nothing is changed: the reset
+ * reports a lost device and the application retries it. A device whose
+ * contexts a failed reset destroyed has nothing left to read back. */
+static BOOL device_reset_context_usable(struct wined3d_device *device)
+{
+    struct wined3d_context *context;
+    BOOL usable;
+
+    if (!device->d3d_initialized || device->contexts_lost)
+        return TRUE;
+
+    context = context_acquire(device, NULL);
+    usable = context && context->valid;
+    context_release(context);
+    return usable;
+}
+
+/* DreamGPU: the reset's old contexts are gone. When the primary context
+ * cannot be created again (no usable window or GL context), the device keeps
+ * no context, reports a lost device, and the next reset retries the creation. */
+static HRESULT device_reset_create_context(struct wined3d_device *device, struct wined3d_swapchain *swapchain)
+{
+    HRESULT hr;
+
+    device->contexts_lost = FALSE;
+    if (FAILED(hr = create_primary_opengl_context(device, swapchain)))
+    {
+        WARN("Failed to create the primary context again, hr %#x, the device stays lost.\n", hr);
+        device->contexts_lost = TRUE;
+        return WINED3DERR_DEVICELOST;
+    }
+    return WINED3D_OK;
+}
