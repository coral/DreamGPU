+/* DreamGPU: unloading without a context. A valid CPU copy in the map
+ * location stays; a PBO cannot be read and is replaced by system memory.
+ * Content held only by unreachable GL objects is lost: system memory is
+ * defined as zero, and application or DIB memory keeps its last bytes, so
+ * later loads and maps find a valid location instead of none. */
+static void dg_surface_keep_cpu_copy(struct wined3d_surface *surface)
+{
+    void *memory = NULL;
+
+    if (surface->resource.map_binding == WINED3D_LOCATION_BUFFER)
+        surface->resource.map_binding = WINED3D_LOCATION_SYSMEM;
+    if (!(surface->locations & surface->resource.map_binding))
+    {
+        WARN("Surface %p content is lost with its GL objects.\n", surface);
+        switch (surface->resource.map_binding)
+        {
+            case WINED3D_LOCATION_SYSMEM:
+                surface_prepare_system_memory(surface);
+                if ((memory = surface->resource.heap_memory))
+                    memset(memory, 0, surface->resource.size);
+                break;
+            case WINED3D_LOCATION_USER_MEMORY:
+                memory = surface->user_memory;
+                break;
+            case WINED3D_LOCATION_DIB:
+                memory = surface->dib.bitmap_data;
+                break;
+        }
+        if (!memory)
+        {
+            ERR("No CPU storage for surface %p.\n", surface);
+            surface_invalidate_location(surface, ~0u);
+            return;
+        }
+        surface_validate_location(surface, surface->resource.map_binding);
+    }
+    surface_invalidate_location(surface, ~surface->resource.map_binding);
+}
