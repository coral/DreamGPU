+/* Expand indexed immediate vertices into the ordinary draw stream. This keeps
+ * topology, FVF translation, clipping and submission on the existing draw path.
+ * Caller holds the Wine mutex; failed allocation never consumes a vertex. */
+static HRESULT d3d_device_append_vertex(struct d3d_device *device, const void *vertex)
+{
+    DWORD required, capacity;
+    BYTE *buffer;
+
+    if (!device->vertex_size || device->nb_vertices >= ~(DWORD)0 / device->vertex_size)
+        return E_OUTOFMEMORY;
+    required = (device->nb_vertices + 1) * device->vertex_size;
+    if (required > device->buffer_size)
+    {
+        capacity = device->buffer_size <= ~(DWORD)0 / 2 ? device->buffer_size * 2 : required;
+        if (capacity < required)
+            capacity = required;
+        if (!(buffer = realloc(device->sysmem_vertex_buffer, capacity)))
+            return E_OUTOFMEMORY;
+        device->sysmem_vertex_buffer = buffer;
+        device->buffer_size = capacity;
+    }
+    memcpy(device->sysmem_vertex_buffer + device->nb_vertices * device->vertex_size, vertex, device->vertex_size);
+    ++device->nb_vertices;
+    return D3D_OK;
+}
