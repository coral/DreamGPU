+/* DreamGPU: without ARB_vertex_buffer_object every vertex buffer lives in
+ * system memory, and so does the zero attribute: a client array that GL
+ * copies at draw time. One process-wide array serves every device under the
+ * wined3d mutex. czvValue counts indices, not the vertices they reach, so at
+ * least 65536 values cover every 16-bit index. NULL when it cannot exist. */
+static const GLvoid *zv_client_array(GLenum enmzvValue, GLuint czvValue,
+        GLuint czvValueElements, const GLvoid *pzvValue)
+{
+    static GLubyte *values, value[16];
+    static GLuint capacity, filled, filled_size;
+    GLuint size = zv_value_el_size(enmzvValue) * czvValueElements;
+    GLuint count = max(czvValue, 65536), i;
+
+    if (!size || czvValueElements > 4 || czvValue > 0x00ffffff)
+        return NULL;
+    if (capacity < size * count)
+    {
+        GLubyte *grown = realloc(values, size * count);
+
+        if (!grown)
+        {
+            ERR("Failed to allocate a zero attribute array of %u values.\n", count);
+            return NULL;
+        }
+        values = grown;
+        capacity = size * count;
+        filled = 0;
+    }
+    if (filled < count || filled_size != size || memcmp(value, pzvValue, size))
+    {
+        for (i = 0; i < count; ++i)
+            memcpy(values + i * size, pzvValue, size);
+        memcpy(value, pzvValue, size);
+        filled = count;
+        filled_size = size;
+    }
+    return values;
+}
