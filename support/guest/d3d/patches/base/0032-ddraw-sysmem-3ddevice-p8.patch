--- a/ddraw/surface.c
+++ b/ddraw/surface.c
@@ -6042,8 +6042,17 @@
          * Keep the public caps, but give owned 3D surfaces GPU backing and
          * CPU access so normal location tracking handles Lock/Blt readback.
          * Caller-owned memory retains its existing pool and validation. */
+        /* DreamGPU: never for palette-indexed or FOURCC formats, which cannot
+         * be render targets. SimCity 3000 creates its news ticker as a 640x48
+         * P8 OFFSCREENPLAIN | SYSTEMMEMORY | 3DDEVICE surface; it stays an
+         * ordinary CPU surface, as DirectDraw's HEL allows. (A render-target
+         * format check is too strict here: without FBOs it requires a matching
+         * WGL pixel format, which RGB565 system-memory targets lack.) */
         if ((desc->ddsCaps.dwCaps & (DDSCAPS_3DDEVICE | DDSCAPS_ZBUFFER))
-                && !(desc->dwFlags & DDSD_LPSURFACE))
+                && !(desc->dwFlags & DDSD_LPSURFACE)
+                && ((desc->ddsCaps.dwCaps & DDSCAPS_ZBUFFER)
+                || !(desc->u4.ddpfPixelFormat.dwFlags & (DDPF_PALETTEINDEXED1 | DDPF_PALETTEINDEXED2
+                        | DDPF_PALETTEINDEXED4 | DDPF_PALETTEINDEXED8 | DDPF_FOURCC))))
         {
             wined3d_desc.pool = WINED3D_POOL_DEFAULT;
             wined3d_desc.usage |= WINED3DUSAGE_DYNAMIC;
