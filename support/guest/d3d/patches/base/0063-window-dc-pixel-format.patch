 success:
-    if (dc == context->hdc && context->hdc_is_private)
+    /* DreamGPU: a window DC keeps the format it was verified or set with, as
+     * a private DC does. WineD3D obtained context->hdc with GetDC for
+     * context->win_handle and holds it for the context's lifetime, so no
+     * other window takes it, except with a class DC (CS_CLASSDC), which
+     * every GetDC for a window of its class moves. WGL sets a window's pixel
+     * format once; only WGL_WINE_pixel_format_passthrough changes it again
+     * (and is what records restore_pf), so with that extension it is checked
+     * on every acquisition as before. Otherwise no wglGetPixelFormat (on NT a
+     * WindowFromDC system call) is repeated for every D3D operation. */
+    if (dc == context->hdc && (context->hdc_is_private
+            || (format == context->pixel_format
+            && !gl_info->supported[WGL_WINE_PIXEL_FORMAT_PASSTHROUGH]
+            && !(GetClassLongA(context->win_handle, GCL_STYLE) & CS_CLASSDC))))
         context->hdc_has_format = TRUE;
     return TRUE;
 }
