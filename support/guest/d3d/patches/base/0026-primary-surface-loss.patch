  *****************************************************************************/
+static HRESULT ddraw_surface_restore(struct ddraw_surface *surface)
+{
+    struct ddraw_surface *current;
+    struct wined3d_display_mode mode;
+    LONG epoch;
+    HRESULT hr;
+
+    if (!surface->primary_chain)
+        return wined3d_surface_restore(surface->wined3d_surface);
+    if (!surface->is_complex_root)
+        return DDERR_IMPLICITLYCREATED;
+    if ((surface->ddraw->cooperative_level & DDSCL_EXCLUSIVE)
+            && surface->ddraw->device_state != DDRAW_DEVICE_STATE_OK)
+        return DDERR_NOEXCLUSIVEMODE;
+
+    epoch = InterlockedCompareExchange(&surface->ddraw->primary_loss_epoch, 0, 0);
+    if (FAILED(hr = wined3d_get_adapter_display_mode(surface->ddraw->wined3d,
+            WINED3DADAPTER_DEFAULT, &mode, NULL)))
+        return hr;
+    if (mode.width != surface->surface_desc.dwWidth || mode.height != surface->surface_desc.dwHeight
+            || mode.format_id != wined3dformat_from_ddrawformat(&surface->surface_desc.u4.ddpfPixelFormat))
+        return DDERR_WRONGMODE;
+
+    current = surface;
+    do
+    {
+        if (FAILED(hr = wined3d_surface_restore(current->wined3d_surface)))
+            return hr;
+        current = current->complex_array[0];
+    } while (current && current != surface);
+    if (epoch != InterlockedCompareExchange(&surface->ddraw->primary_loss_epoch, 0, 0))
+        return DDERR_WRONGMODE;
+
+    /* Implicit flip buffers form a ring. Explicit attachments do not belong
+     * to this restoration and retain their own loss state. */
+    current = surface;
+    do
+    {
+        current->restored_primary_epoch = epoch;
+        current = current->complex_array[0];
+    } while (current && current != surface);
+    return DD_OK;
+}
