+/* Transfer the active backbuffer's depth without exposing partially read CPU
+ * memory. A failed upload leaves CPU storage authoritative so a later draw can
+ * retry. Unavailable bindings and unsupported layouts are errors, never copies.
+ * The FBO/depth-texture path remains the upstream implementation. */
+static HRESULT surface_transfer_depth(struct wined3d_surface *surface,
+        struct wined3d_context *context, DWORD location)
+{
+    const struct wined3d_gl_info *gl_info;
+    struct wined3d_bo_address memory;
+    DWORD depth_mask, stencil_mask;
+    UINT width = surface->resource.width, height = surface->resource.height;
+    UINT drawable_width, drawable_height, i;
+    GLuint *depth;
+    BYTE *stencil;
+    SIZE_T count;
+    BOOL upload = location == WINED3D_LOCATION_DRAWABLE, flip;
+    GLenum error;
+
+    if (!context || !context->valid || context_get_current() != context || !context->current_rt
+            || wined3d_settings.offscreen_rendering_mode != ORM_BACKBUFFER
+            || !surface_depth_layout(surface, &depth_mask, &stencil_mask))
+        return WINED3DERR_INVALIDCALL;
+    if (upload ? !(surface->locations & surface_simple_locations)
+            : !(surface->locations & WINED3D_LOCATION_DRAWABLE))
+        return WINED3DERR_INVALIDCALL;
+    surface_get_drawable_size(context->current_rt, context, &drawable_width, &drawable_height);
+    if (!width || !height || width > drawable_width || height > drawable_height
+            || width > ~(SIZE_T)0 / height / (sizeof(*depth) + sizeof(*stencil)))
+        return WINED3DERR_INVALIDCALL;
+    surface_get_memory(surface, &memory, upload ? surface->locations : location);
+    if (!memory.addr || memory.buffer_object)
+        return WINED3DERR_INVALIDCALL;
+    count = (SIZE_T)width * height;
+    if (!(depth = malloc(count * (sizeof(*depth) + sizeof(*stencil)))))
+        return E_OUTOFMEMORY;
+    stencil = (BYTE *)(depth + count);
+    flip = !context->render_offscreen;
+    if (upload) surface_depth_convert(surface, memory.addr, depth, stencil, TRUE, flip, depth_mask, stencil_mask);
+    gl_info = context->gl_info;
+    /* Drain prior errors before measuring this transaction, with a bound for a
+     * dead transport that continually reports an error. */
+    for (i = 0; i < 16 && gl_info->gl_ops.gl.p_glGetError() != GL_NO_ERROR; ++i) {}
+    if (i == 16) { free(depth); return WINED3DERR_INVALIDCALL; }
+    gl_info->gl_ops.gl.p_glPushAttrib(GL_ALL_ATTRIB_BITS);
+    gl_info->gl_ops.gl.p_glPushClientAttrib(GL_CLIENT_PIXEL_STORE_BIT);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_PACK_SWAP_BYTES, GL_FALSE);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+    gl_info->gl_ops.gl.p_glPixelStorei(GL_UNPACK_SWAP_BYTES, GL_FALSE);
+    gl_info->gl_ops.gl.p_glPixelTransferf(GL_DEPTH_SCALE, 1.0f);
+    gl_info->gl_ops.gl.p_glPixelTransferf(GL_DEPTH_BIAS, 0.0f);
+    gl_info->gl_ops.gl.p_glPixelTransferi(GL_INDEX_SHIFT, 0);
+    gl_info->gl_ops.gl.p_glPixelTransferi(GL_INDEX_OFFSET, 0);
+    gl_info->gl_ops.gl.p_glPixelTransferi(GL_MAP_STENCIL, GL_FALSE);
+    if (upload)
+    {
+        gl_info->gl_ops.gl.p_glDisable(GL_SCISSOR_TEST);
+        gl_info->gl_ops.gl.p_glDisable(GL_ALPHA_TEST);
+        gl_info->gl_ops.gl.p_glDisable(GL_STENCIL_TEST);
+        gl_info->gl_ops.gl.p_glDisable(GL_BLEND);
+        gl_info->gl_ops.gl.p_glDisable(GL_FOG);
+        for (i = 0; i < 6; ++i) gl_info->gl_ops.gl.p_glDisable(GL_CLIP_PLANE0 + i);
+        gl_info->gl_ops.gl.p_glEnable(GL_DEPTH_TEST);
+        gl_info->gl_ops.gl.p_glDepthFunc(GL_ALWAYS);
+        gl_info->gl_ops.gl.p_glDepthMask(GL_TRUE);
+        gl_info->gl_ops.gl.p_glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+        gl_info->gl_ops.gl.p_glStencilMask(stencil_mask);
+        gl_info->gl_ops.gl.p_glViewport(0, 0, width, height);
+        gl_info->gl_ops.gl.p_glPixelZoom(1.0f, 1.0f);
+        gl_info->gl_ops.gl.p_glMatrixMode(GL_PROJECTION);
+        gl_info->gl_ops.gl.p_glPushMatrix();
+        gl_info->gl_ops.gl.p_glLoadIdentity();
+        gl_info->gl_ops.gl.p_glMatrixMode(GL_MODELVIEW);
+        gl_info->gl_ops.gl.p_glPushMatrix();
+        gl_info->gl_ops.gl.p_glLoadIdentity();
+        gl_info->gl_ops.gl.p_glRasterPos3f(-1.0f, -1.0f, 0.0f);
+        gl_info->gl_ops.gl.p_glDrawPixels(width, height, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, depth);
+        if (stencil_mask)
+            gl_info->gl_ops.gl.p_glDrawPixels(width, height, GL_STENCIL_INDEX, GL_UNSIGNED_BYTE, stencil);
+        gl_info->gl_ops.gl.p_glPopMatrix();
+        gl_info->gl_ops.gl.p_glMatrixMode(GL_PROJECTION);
+        gl_info->gl_ops.gl.p_glPopMatrix();
+        /* Completion is part of upload success; queued transfer errors must not
+         * validate the destination before the native driver executes them. */
+        gl_info->gl_ops.gl.p_glFinish();
+    }
+    else
+    {
+        gl_info->gl_ops.gl.p_glReadPixels(0, 0, width, height, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, depth);
+        if (stencil_mask)
+            gl_info->gl_ops.gl.p_glReadPixels(0, 0, width, height, GL_STENCIL_INDEX, GL_UNSIGNED_BYTE, stencil);
+    }
+    gl_info->gl_ops.gl.p_glPopClientAttrib();
+    gl_info->gl_ops.gl.p_glPopAttrib();
+    error = gl_info->gl_ops.gl.p_glGetError();
+    if (error == GL_NO_ERROR)
+    {
+        if (!upload) surface_depth_convert(surface, memory.addr, depth, stencil, FALSE, flip, depth_mask, stencil_mask);
+        surface_validate_location(surface, location);
+        surface->ds_current_size.cx = width;
+        surface->ds_current_size.cy = height;
+    }
+    free(depth);
+    return error == GL_NO_ERROR ? WINED3D_OK : WINED3DERR_INVALIDCALL;
+}
