+/* DirectDraw's CPU depth layout uses the masks returned by ddraw/utils.c.
+ * Keep GL's normalized depth and unnormalized stencil in separate staging
+ * arrays: packed depth/stencil textures are not a GL 1.1 capability. */
+static BOOL surface_depth_layout(const struct wined3d_surface *surface, DWORD *depth_mask, DWORD *stencil_mask)
+{
+    *stencil_mask = 0;
+    switch (surface->resource.format->id)
+    {
+        case WINED3DFMT_D16_LOCKABLE:
+        case WINED3DFMT_D16_UNORM: *depth_mask = 0xffff; return TRUE;
+        case WINED3DFMT_D32_UNORM: *depth_mask = 0xffffffff; return TRUE;
+        case WINED3DFMT_D24_UNORM_S8_UINT: *stencil_mask = 0xff; /* fall through */
+        case WINED3DFMT_X8D24_UNORM: *depth_mask = 0xffffff; return TRUE;
+        case WINED3DFMT_S1_UINT_D15_UNORM: *depth_mask = 0x7fff; *stencil_mask = 1; return TRUE;
+        case WINED3DFMT_S4X4_UINT_D24_UNORM: *depth_mask = 0xffffff; *stencil_mask = 15; return TRUE;
+        default: return FALSE;
+    }
+}
+
+static void surface_depth_convert(struct wined3d_surface *surface, BYTE *memory,
+        GLuint *depth, BYTE *stencil, BOOL upload, BOOL flip, DWORD depth_mask, DWORD stencil_mask)
+{
+    UINT x, y, width = surface->resource.width, height = surface->resource.height;
+    UINT bytes = surface->resource.format->byte_count, pitch = wined3d_surface_get_pitch(surface);
+    UINT shift = depth_mask == 0x7fff ? 15 : 24;
+    for (y = 0; y < height; ++y)
+    {
+        BYTE *row = memory + (flip ? height - 1 - y : y) * pitch;
+        for (x = 0; x < width; ++x)
+        {
+            DWORD value = 0;
+            UINT i = y * width + x;
+            if (upload)
+            {
+                memcpy(&value, row + x * bytes, bytes);
+                depth[i] = (GLuint)(((ULONGLONG)(value & depth_mask) * 0xffffffffu + depth_mask / 2) / depth_mask);
+                if (stencil_mask) stencil[i] = (value >> shift) & stencil_mask;
+            }
+            else
+            {
+                value = (DWORD)(((ULONGLONG)depth[i] * depth_mask + 0x7fffffffu) / 0xffffffffu);
+                if (stencil_mask) value |= (DWORD)(stencil[i] & stencil_mask) << shift;
+                memcpy(row + x * bytes, &value, bytes);
+            }
+        }
+    }
+}
