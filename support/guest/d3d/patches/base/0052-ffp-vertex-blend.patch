+/* DreamGPU: a blended array draw (see dg_vertex_blend) takes client arrays
+ * of the blended positions (four floats) and normals (three) in place of
+ * Wine's position and normal arrays; every other array stays as
+ * load_vertex_data set it. GL array index j is vertex load_base_vertex_index
+ * + j of every stream, as each array pointer is offset by that many
+ * vertices: start_idx.. for glDrawArrays, or each index (plus GL's base
+ * vertex) for glDrawElements. Streams are read through their system memory
+ * copy (0037), which conversion never writes. */
+#define DG_BLEND_LOCAL_VERTICES 64
+
+struct dg_vertex_blend_arrays
+{
+    float *values; /* NULL: not prepared */
+    ULONG_PTR positions, normals; /* GL array index j reads [j - first] */
+    float local[DG_BLEND_LOCAL_VERTICES * 7];
+};
+
+/* An element's vertex 0 in system memory, when vertices first..last lie
+ * within its stream; NULL otherwise. Stride zero, which drawStridedSlow
+ * repeats and GL arrays read packed, is not blended. */
+static const BYTE *dg_vertex_blend_source(struct wined3d_context *context, const struct wined3d_state *state,
+        const struct wined3d_stream_info_element *e, int64_t first, int64_t last)
+{
+    struct wined3d_buffer *buffer = state->streams[e->stream_idx].buffer;
+    const BYTE *memory;
+    ULONG_PTR offset;
+
+    if (!buffer || !(memory = buffer_get_sysmem(buffer, context))
+            || (!e->data.buffer_object && (ULONG_PTR)e->data.addr < (ULONG_PTR)memory))
+        return NULL;
+    /* A buffer object element holds its offset, a system memory one its address. */
+    offset = (ULONG_PTR)e->data.addr - (e->data.buffer_object ? 0 : (ULONG_PTR)memory);
+    if (!dg_xyzrhw_span(buffer->resource.size, offset, e->stride, e->format->byte_count, first, last))
+        return NULL;
+    return memory + offset;
+}
+
+/* The blended arrays of an array draw. FALSE, before any GL call, draws the
+ * streams unblended. */
+static BOOL dg_vertex_blend_prepare(struct dg_vertex_blend_arrays *arrays, const struct dg_vertex_blend *blend,
+        struct wined3d_context *context, const struct wined3d_state *state, const void *idx_data,
+        UINT idx_size, UINT start_idx, UINT index_count, BOOL indexed)
+{
+    const struct wined3d_gl_info *gl_info = context->gl_info;
+    const BYTE *weights, *position, *normal = NULL;
+    int64_t first, last, final, range, base, j;
+    const void *indices = NULL;
+    float *values, *normals;
+    INT index_base = 0;
+
+    arrays->values = NULL;
+    if (indexed)
+    {
+        UINT entries;
+
+        if (gl_info->supported[ARB_DRAW_ELEMENTS_BASE_VERTEX])
+            index_base = state->base_vertex_index;
+        /* The index buffer's system memory copy (0037) holds every index. */
+        if (!state->index_buffer || (idx_size != 2 && idx_size != 4))
+            return FALSE;
+        entries = state->index_buffer->resource.size / idx_size;
+        indices = idx_data ? idx_data : buffer_get_sysmem(state->index_buffer, context);
+        if (!indices || start_idx > entries || index_count > entries - start_idx)
+            return FALSE;
+    }
+    if (!dg_fog_coord_range(indices, idx_size, start_idx, index_count, index_base, &first, &last, &final))
+        return FALSE;
+    base = state->load_base_vertex_index;
+    if (!(weights = dg_vertex_blend_source(context, state, blend->weights, base + first, base + last))
+            || !(position = dg_vertex_blend_source(context, state, blend->position, base + first, base + last))
+            || (blend->normal && !(normal = dg_vertex_blend_source(context, state, blend->normal,
+                    base + first, base + last))))
+        return FALSE;
+
+    range = last - first + 1;
+    if ((uint64_t)range > ~(size_t)0 / (7 * sizeof(float)))
+        return FALSE;
+    values = range <= DG_BLEND_LOCAL_VERTICES ? arrays->local : malloc((size_t)range * 7 * sizeof(float));
+    if (!values)
+        return FALSE;
+    normals = values + 4 * range;
+    /* The pointers biased below the storage must not wrap. */
+    if ((uint64_t)first > (ULONG_PTR)values / (4 * sizeof(float))
+            || (uint64_t)first > (ULONG_PTR)normals / (3 * sizeof(float)))
+    {
+        if (values != arrays->local)
+            free(values);
+        return FALSE;
+    }
+    for (j = 0; j < range; ++j)
+    {
+        ULONG_PTR vertex = (ULONG_PTR)(base + first + j);
+
+        dg_vertex_blend_vertex(blend, weights + vertex * blend->weights->stride,
+                position + vertex * blend->position->stride,
+                normal ? normal + vertex * blend->normal->stride : NULL, values + 4 * j, normals + 3 * j);
+    }
+    arrays->values = values;
+    arrays->positions = (ULONG_PTR)values - (ULONG_PTR)first * 4 * sizeof(float);
+    arrays->normals = (ULONG_PTR)normals - (ULONG_PTR)first * 3 * sizeof(float);
+    return TRUE;
+}
+
+/* Context activation is done by the caller. */
+static void dg_vertex_blend_bind(const struct wined3d_gl_info *gl_info, const struct wined3d_state *state,
+        const struct dg_vertex_blend *blend, const struct dg_vertex_blend_arrays *arrays)
+{
+    /* Client arrays: Wine's array loaders leave a buffer object bound. */
+    if (gl_info->supported[ARB_VERTEX_BUFFER_OBJECT])
+        GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, 0));
+    gl_info->gl_ops.gl.p_glVertexPointer(4, GL_FLOAT, 0, (const void *)arrays->positions);
+    if (blend->normal)
+        gl_info->gl_ops.gl.p_glNormalPointer(GL_FLOAT, 0, (const void *)arrays->normals);
+    checkGLcall("vertex blend arrays");
+    dg_vertex_blend_begin(gl_info, state);
+}
+
+/* Context activation is done by the caller. The modelview, and the position
+ * and normal arrays exactly as load_vertex_data set them, so no descriptor
+ * keeps this storage and the next draw needs no reload. */
+static void dg_vertex_blend_unbind(const struct wined3d_gl_info *gl_info, const struct wined3d_state *state,
+        const struct dg_vertex_blend *blend, struct dg_vertex_blend_arrays *arrays)
+{
+    const struct wined3d_stream_info_element *e = blend->position;
+
+    dg_vertex_blend_end(gl_info);
+    if (gl_info->supported[ARB_VERTEX_BUFFER_OBJECT])
+        GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, e->data.buffer_object));
+    gl_info->gl_ops.gl.p_glVertexPointer(e->format->gl_vtx_format, e->format->gl_vtx_type, e->stride,
+            e->data.addr + state->load_base_vertex_index * e->stride);
+    if ((e = blend->normal))
+    {
+        if (gl_info->supported[ARB_VERTEX_BUFFER_OBJECT])
+            GL_EXTCALL(glBindBuffer(GL_ARRAY_BUFFER, e->data.buffer_object));
+        gl_info->gl_ops.gl.p_glNormalPointer(e->format->gl_vtx_type, e->stride,
+                e->data.addr + state->load_base_vertex_index * e->stride);
+    }
+    checkGLcall("vertex blend arrays release");
+    if (arrays->values != arrays->local)
+        free(arrays->values);
+    arrays->values = NULL;
+}
