--- a/wined3d/surface.c
+++ b/wined3d/surface.c
@@ -5870,6 +5870,18 @@
     cpu_blit_blit_surface,
 };
 
+/* DreamGPU: with framebuffer objects a surface that is its own source is one
+ * GL image: GL leaves a blit, copy or textured draw between overlapping regions
+ * of it undefined (without FBOs the destination was the drawable). The CPU
+ * blitter copies overlapping rectangles in a safe order. */
+static BOOL dg_surface_blt_self_overlap(const struct wined3d_surface *src_surface, const RECT *src_rect,
+        const struct wined3d_surface *dst_surface, const RECT *dst_rect)
+{
+    return wined3d_settings.offscreen_rendering_mode == ORM_FBO && src_surface == dst_surface
+            && src_rect->left < dst_rect->right && dst_rect->left < src_rect->right
+            && src_rect->top < dst_rect->bottom && dst_rect->top < src_rect->bottom;
+}
+
 /* ORM_BACKBUFFER borrows the window drawable for offscreen rendering.
  * A desktop-sized DirectDraw primary can exceed that drawable. Rendering it
  * there clips before its texture copy, even with a larger GL viewport. Keep
@@ -6024,6 +6036,12 @@
         goto cpu;
     }
 
+    if (dg_surface_blt_self_overlap(src_surface, &src_rect, dst_surface, &dst_rect))
+    {
+        WARN_(d3d_perf)("Overlapping blit within one surface, using CPU blit.\n");
+        goto cpu;
+    }
