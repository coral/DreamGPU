+/* DreamGPU: ValidateVertexShader and ValidatePixelShader as upstream Wine's
+ * d3d8_main.c implements them, with the d3d8 runtime's signatures: a vertex
+ * shader's declaration and a D3DCAPS8 are parameters, not reserved pointers
+ * that must be NULL, and the last parameter receives an error string from
+ * the process heap, which callers free with HeapFree. D3DX8's assembler,
+ * statically linked into games, does so after validating each shader it
+ * assembles. The stubs failed any call with a declaration or caps and never
+ * wrote the string. Only the version token is checked, against the caps when
+ * given; the message is empty unless return_error is set. */
+static void d3d8_validation_message(BOOL return_error, const char *message, char **errors)
+{
+    SIZE_T message_size;
+
+    if (!return_error)
+        message = "";
+    message_size = strlen(message) + 1;
+    if (errors && (*errors = HeapAlloc(GetProcessHeap(), 0, message_size)))
+        memcpy(*errors, message, message_size);
+}
+
