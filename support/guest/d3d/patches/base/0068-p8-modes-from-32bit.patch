 /* Note: dx9 supplies a format. Calls from d3d8 supply WINED3DFMT_UNKNOWN */
+/* DreamGPU: wined3d_set_adapter_display_mode never sets an 8-bit desktop
+ * mode; a P8 request switches to 32 bits per pixel and the palette is
+ * converted on presentation (the JHFIX branch there). Enumerate P8 modes the
+ * same way, from the 32-bit modes the request will set, so applications that
+ * look for an 8-bit mode before setting it (Age of Empires II) find one even
+ * when the display driver lists none, as Windows 2000/XP drivers here do (0068). */
+static UINT wined3d_mode_enum_bits(const struct wined3d_format *format)
+{
+    if (format->byte_count == 1)
+        return 4 * CHAR_BIT;
+    return format->byte_count * CHAR_BIT;
+}
+
 UINT CDECL wined3d_get_adapter_mode_count(const struct wined3d *wined3d, UINT adapter_idx,
