+/* ORM_BACKBUFFER borrows the window drawable for offscreen rendering.
+ * A desktop-sized DirectDraw primary can exceed that drawable. Rendering it
+ * there clips before its texture copy, even with a larger GL viewport. Keep
+ * the existing framebuffer-to-texture / CPU fallback for that case. */
+static BOOL dg_surface_backbuffer_blit_fits(const struct wined3d_surface *surface)
+{
+    struct wined3d_context *context;
+    RECT client;
+    BOOL fits;
+
+    if (wined3d_settings.offscreen_rendering_mode != ORM_BACKBUFFER
+            || !wined3d_resource_is_offscreen(&surface->container->resource))
+        return TRUE;
+
+    context = context_acquire(surface->resource.device, NULL);
+    if (!context)
+        return FALSE;
+    fits = context->valid && GetClientRect(context->win_handle, &client)
+            && client.right > client.left && client.bottom > client.top
+            && surface->resource.width <= (UINT)(client.right - client.left)
+            && surface->resource.height <= (UINT)(client.bottom - client.top);
+    context_release(context);
+    return fits;
+}
+
