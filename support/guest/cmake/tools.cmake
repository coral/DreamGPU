set(DREAMGPU_RUNNER_ID "" CACHE STRING "Rust-generated identity of runner source and build recipe")
string(LENGTH "${DREAMGPU_RUNNER_ID}" runner_id_length)
if(NOT runner_id_length EQUAL 64 OR NOT DREAMGPU_RUNNER_ID MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Rust orchestration must supply a 64-hex DREAMGPU_RUNNER_ID")
endif()
function(dreamgpu_tool target filename source)
  cmake_parse_arguments(TOOL "MEMORY;NT" "" "LIBRARIES;DEFINITIONS" ${ARGN})
  set(units "${DREAMGPU_ROOT}/tools/${source}")
  if(TOOL_MEMORY)
    list(APPEND units "${DREAMGPU_GUEST}/nt/memory.cpp")
  endif()
  add_executable(${target} ${units})
  dreamgpu_freestanding(${target})
  target_compile_options(${target} PRIVATE -O2 -Werror)
  if(TOOL_NT)
    target_compile_options(${target} PRIVATE -Wno-unused-parameter -Wno-multichar -Wno-cast-function-type)
    target_compile_definitions(${target} PRIVATE __USE_MINGW_ANSI_STDIO=0)
    set(version 0x0500)
    set(subsystem 5.0)
    set(directory nt5)
  else()
    set(version 0x0400)
    set(subsystem 4.0)
    set(directory common)
  endif()
  target_compile_definitions(${target} PRIVATE _WIN32_WINNT=${version} WINVER=${version} ${TOOL_DEFINITIONS})
  target_link_options(${target} PRIVATE -nostdlib "-Wl,--entry,_WinMainCRTStartup@0,--subsystem,windows:${subsystem},--no-insert-timestamp,--fatal-warnings")
  target_link_libraries(${target} PRIVATE kernel32 user32 ${TOOL_LIBRARIES} gcc)
  set_target_properties(${target} PROPERTIES OUTPUT_NAME "${filename}" SUFFIX ".EXE"
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/tools/${directory}" LINKER_LANGUAGE C)
  install(TARGETS ${target} RUNTIME DESTINATION tools/${directory} COMPONENT tools)
  set(DREAMGPU_TOOL_TARGETS ${DREAMGPU_TOOL_TARGETS} ${target} PARENT_SCOPE)
endfunction()
