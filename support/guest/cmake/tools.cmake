# Source-only fixed bootstrap; separate from the driver and runner packages.
if(DREAMGPU_GUEST_OS STREQUAL "nt5")
  dreamgpu_tool(dg_serial_setup DGSERIAL benchmark/serial-setup.cpp NT LIBRARIES advapi32)
endif()
if(DREAMGPU_GUEST_OS STREQUAL "win98")
  dreamgpu_tool(dg_win98_icd_bootstrap DGICDBT opengl/win98-icd-bootstrap.cpp MEMORY LIBRARIES gdi32 advapi32)
  dreamgpu_tool(dg_win98_icd_inspect DGICDDI opengl/win98-icd-bootstrap.cpp MEMORY DEFINITIONS DG_ICD_INSPECT LIBRARIES gdi32 advapi32)
  dreamgpu_tool(dg_dma_request DGDMA win9x/dma32.c LIBRARIES cfgmgr32 setupapi advapi32 DEFINITIONS DG_DMA_READONLY=0)
  dreamgpu_tool(dg_dma_readonly DGDMAQ win9x/dma32.c LIBRARIES cfgmgr32 setupapi advapi32 DEFINITIONS DG_DMA_READONLY=1)
  dreamgpu_tool(dg_probe_update DGUPDATE win9x/probe-update32.c LIBRARIES advapi32)
  # Existing WinMain-only helpers use a tiny declared startup adapter; generated
  # here without modifying their source or requiring an interpreter.
  foreach(pair "loader32;DGLOAD" "setup32;DGSET9")
    list(GET pair 0 source)
    list(GET pair 1 name)
    set(wrapper "${CMAKE_BINARY_DIR}/${source}-startup.c")
    file(GENERATE OUTPUT "${wrapper}" CONTENT "#include \"${DREAMGPU_ROOT}/tools/win9x/${source}.c\"\nvoid WINAPI WinMainCRTStartup(void){ExitProcess(WinMain(GetModuleHandleA(0),0,0,0));}\n")
    add_executable(dg_${source} "${wrapper}")
    dreamgpu_user(dg_${source})
    target_link_options(dg_${source} PRIVATE -Wl,--entry,_WinMainCRTStartup@0)
    target_link_libraries(dg_${source} PRIVATE kernel32 user32 advapi32 gcc)
    set_target_properties(dg_${source} PROPERTIES OUTPUT_NAME "${name}" SUFFIX ".EXE" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/tools/win98")
    list(APPEND DREAMGPU_TOOL_TARGETS dg_${source})
    install(TARGETS dg_${source} RUNTIME DESTINATION tools/win98 COMPONENT tools)
  endforeach()
  foreach(pair "channel32;DGCHAN9" "wgl32;DGWGL9" "mode32;DG9MODE" "cd32;DGCD" "identity32;DGID" "access32;DGACC")
    list(GET pair 0 source)
    list(GET pair 1 name)
    if(source STREQUAL "channel32")
      set(extension cpp)
    else()
      set(extension c)
    endif()
    add_executable(dg_${source} WIN32 "${DREAMGPU_ROOT}/tools/win9x/${source}.${extension}")
    dreamgpu_cpp(dg_${source})
    target_compile_options(dg_${source} PRIVATE -O2 -march=pentium3 -mno-sse -mno-sse2)
    if(NOT source MATCHES "^(channel32|wgl32)$")
      target_compile_options(dg_${source} PRIVATE -Wall -Wextra -Werror)
    endif()
    target_compile_definitions(dg_${source} PRIVATE _WIN32_WINNT=0x0400 WINVER=0x0400)
    target_include_directories(dg_${source} PRIVATE "${DREAMGPU_GUEST}/include" "${DREAMGPU_GUEST}/nt/include")
    target_link_options(dg_${source} PRIVATE -static-libgcc -Wl,--major-os-version,4,--minor-os-version,0,--major-subsystem-version,4,--minor-subsystem-version,0)
    target_link_libraries(dg_${source} PRIVATE kernel32 user32 gdi32 advapi32 winmm)
    set_target_properties(dg_${source} PROPERTIES OUTPUT_NAME "${name}" SUFFIX ".EXE" RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/tools/win98")
    list(APPEND DREAMGPU_TOOL_TARGETS dg_${source})
    install(TARGETS dg_${source} RUNTIME DESTINATION tools/win98 COMPONENT tools)
  endforeach()
  # Actual segmented NE diagnostics still require Open Watcom. These commands
  # preserve the real ABI rather than passing a fake Win16 model to clang.
  set(watcom_tools)
  foreach(pair "diagnose16;DG9DIAG;16" "blit16;DG9BLT;16")
    list(GET pair 0 source)
    list(GET pair 1 name)
    list(GET pair 2 bits)
    set(destination "${CMAKE_BINARY_DIR}/tools/win98/${name}.EXE")
    if(bits EQUAL 16)
      set(compiler wcl)
      set(options -bt=windows -l=windows -ms)
      set(headers win)
    else()
      set(compiler wcl386)
      set(options -bt=nt -l=nt_win)
      set(headers nt)
    endif()
    add_custom_command(OUTPUT "${destination}"
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/tools/win98"
      COMMAND "${CMAKE_COMMAND}" -E env "WATCOM=${DREAMGPU_WATCOM_ROOT}"
        "PATH=${DREAMGPU_WATCOM_ROOT}/binl64:$ENV{PATH}" "INCLUDE=${DREAMGPU_WATCOM_ROOT}/h:${DREAMGPU_WATCOM_ROOT}/h/${headers}"
        "${DREAMGPU_WATCOM_ROOT}/binl64/${compiler}" -q ${options} -s -3
        "-i=${DREAMGPU_GUEST}/nt/include" "-i=${DREAMGPU_GUEST}/include" "-fe=${destination}"
        "${DREAMGPU_ROOT}/tools/win9x/${source}.c"
      WORKING_DIRECTORY "${DREAMGPU_VMDISP_SOURCE}" DEPENDS "${DREAMGPU_ROOT}/tools/win9x/${source}.c" VERBATIM)
    list(APPEND watcom_tools "${destination}")
    install(FILES "${destination}" DESTINATION tools/win98 COMPONENT tools)
  endforeach()
  add_custom_target(dreamgpu-win98-tools DEPENDS ${watcom_tools})
  list(APPEND DREAMGPU_TOOL_TARGETS dreamgpu-win98-tools)
endif()
