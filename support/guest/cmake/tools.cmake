  dreamgpu_tool(dg_d3d${version} DGD3D${version} ${source} MEMORY LIBRARIES gdi32 DEFINITIONS DG_D3D_VERSION=${version})
  dreamgpu_tool(dg_system_d3d${version} DGSYS${version} ${source} MEMORY LIBRARIES gdi32 DEFINITIONS DG_D3D_VERSION=${version} DG_SYSTEM_D3D)
endforeach()
