# The helpers need Win98's foreground API declarations, while imports remain
# dynamically bounded to APIs available on the accepted legacy OSes.
foreach(target dg_ut_setup dg_ut_probe dg_ut_setup-d3d dg_ut_logs dg_ut_d3d)
  get_target_property(definitions ${target} COMPILE_DEFINITIONS)
  list(REMOVE_ITEM definitions WINVER=0x0400)
  set_property(TARGET ${target} PROPERTY COMPILE_DEFINITIONS ${definitions} WINVER=0x0410)
endforeach()
