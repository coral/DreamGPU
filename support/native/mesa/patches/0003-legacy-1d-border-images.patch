+
+/* Border CPU images and GPU atlases have a separate 64 MiB process budget.
+ * Registry entries belong to exact pipe_resource identities, never templates.
+ * Final resource release (including cached views in other contexts) alone
+ * retires atlas credit. No work is added to texture sampling or map/unmap.
+ */
+#define BORDER_STORAGE_LIMIT (64u * 1024u * 1024u)
+#define BORDER_RESOURCE_BUCKETS 1024u
+struct border_resource_entry {
+   struct border_resource_entry *next;
+   uintptr_t resource;
+   size_t bytes;
+};
+static simple_mtx_t border_storage_mutex = SIMPLE_MTX_INITIALIZER;
+static size_t border_storage_bytes;
+static unsigned border_resource_count;
+static struct border_resource_entry *border_resources[BORDER_RESOURCE_BUCKETS];
+
+bool
+util_border_storage_reserve(size_t bytes)
+{
+   simple_mtx_lock(&border_storage_mutex);
+   bool ok = bytes <= BORDER_STORAGE_LIMIT - border_storage_bytes;
+   if (ok)
+      border_storage_bytes += bytes;
+   simple_mtx_unlock(&border_storage_mutex);
+   return ok;
+}
+
+void
+util_border_storage_release(size_t bytes)
+{
+   simple_mtx_lock(&border_storage_mutex);
+   assert(bytes <= border_storage_bytes);
+   border_storage_bytes -= bytes;
+   simple_mtx_unlock(&border_storage_mutex);
+}
+
+bool
+util_border_resource_register(struct pipe_resource *resource, size_t bytes)
+{
+   if (!util_border_storage_reserve(sizeof(struct border_resource_entry)))
+      return false;
+   struct border_resource_entry *entry = malloc(sizeof(*entry));
+   if (!entry) {
+      util_border_storage_release(sizeof(*entry));
+      return false;
+   }
+   unsigned bucket = ((uintptr_t)resource >> 6) % BORDER_RESOURCE_BUCKETS;
+   entry->resource = (uintptr_t)resource;
+   entry->bytes = bytes;
+   simple_mtx_lock(&border_storage_mutex);
+   for (struct border_resource_entry *old = border_resources[bucket]; old; old = old->next) {
+      if (old->resource == (uintptr_t)resource) {
+         simple_mtx_unlock(&border_storage_mutex);
+         free(entry);
+         util_border_storage_release(sizeof(*entry));
+         return false;
+      }
+   }
+   entry->next = border_resources[bucket];
+   border_resources[bucket] = entry;
+   p_atomic_inc(&border_resource_count);
+   simple_mtx_unlock(&border_storage_mutex);
+   return true;
+}
+
+void *
+util_border_resource_detach(uintptr_t resource)
+{
+   if (!p_atomic_read(&border_resource_count))
+      return NULL;
+   unsigned bucket = ((uintptr_t)resource >> 6) % BORDER_RESOURCE_BUCKETS;
+   simple_mtx_lock(&border_storage_mutex);
+   struct border_resource_entry **at = &border_resources[bucket];
+   while (*at && (*at)->resource != resource)
+      at = &(*at)->next;
+   struct border_resource_entry *entry = *at;
+   if (entry) {
+      *at = entry->next;
+      p_atomic_dec(&border_resource_count);
+   }
+   simple_mtx_unlock(&border_storage_mutex);
+   return entry;
+}
+
+void
+util_border_resource_retire(void *token)
+{
+   struct border_resource_entry *entry = token;
+   if (!entry)
+      return;
+   size_t bytes = entry->bytes + sizeof(*entry);
+   free(entry);
+   util_border_storage_release(bytes);
+}
