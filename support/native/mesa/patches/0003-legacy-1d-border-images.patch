+/* Fetch a true image texel, including independent left/right borders.
+ * Coordinates address the private atlas, never invoke its sampler filtering.
+ */
+static nir_def *
+border_fetch(struct texenv_fragment_program *p, unsigned unit, nir_def *level,
+             nir_def *size, nir_def *index, bool repeat, bool edge)
+{
+   nir_builder *b = p->b;
+   nir_def *row = nir_imul_imm(b, level, 2);
+   if (repeat) {
+      index = nir_imod(b, index, size);
+   } else if (edge) {
+      index = nir_iclamp(b, index, nir_imm_int(b, 0), nir_iadd_imm(b, size, -1));
+   } else {
+      nir_def *left = nir_ilt_imm(b, index, 0);
+      nir_def *right = nir_ige(b, index, size);
+      row = nir_iadd(b, row, nir_b2i32(b, nir_ior(b, left, right)));
+      index = nir_bcsel(b, left, nir_imm_int(b, 0),
+                 nir_bcsel(b, right, nir_imm_int(b, 1), index));
+   }
+   nir_variable *var = p->sampler_vars[unit];
+   if (!var) {
+      var = nir_variable_create(b->shader, nir_var_uniform,
+         glsl_sampler_type(GLSL_SAMPLER_DIM_2D, false, false, GLSL_TYPE_FLOAT),
+         ralloc_asprintf(b->shader, "border_sampler_%u", unit));
+      var->data.binding = unit;
+      var->data.explicit_binding = true;
+      p->sampler_vars[unit] = var;
+   }
+   nir_deref_instr *deref = nir_build_deref_var(b, var);
+   nir_tex_instr *tex = nir_tex_instr_create(b->shader, 3);
+   tex->op = nir_texop_txf;
+   tex->dest_type = nir_type_float32;
+   tex->texture_index = unit;
+   tex->sampler_index = unit;
+   tex->sampler_dim = GLSL_SAMPLER_DIM_2D;
+   tex->coord_components = 2;
+   tex->src[0] = nir_tex_src_for_ssa(nir_tex_src_texture_deref, &deref->def);
+   tex->src[1] = nir_tex_src_for_ssa(nir_tex_src_coord, nir_vec2(b, index, row));
+   tex->src[2] = nir_tex_src_for_ssa(nir_tex_src_lod, nir_imm_int(b, 0));
+   nir_def_init(&tex->instr, &tex->def, 4, 32);
+   nir_builder_instr_insert(b, &tex->instr);
+   return &tex->def;
+}
+
+static nir_def *
+border_sample_level(struct texenv_fragment_program *p, unsigned unit,
+                    nir_def *s, nir_def *level, bool linear)
+{
+   nir_builder *b = p->b;
+   unsigned width = p->state->unit[unit].border_width;
+   GLenum wrap = p->state->unit[unit].border_wrap;
+   bool repeat = wrap == GL_REPEAT;
+   bool edge = wrap == GL_CLAMP_TO_EDGE || wrap == GL_MIRRORED_REPEAT ||
+               wrap == GL_MIRROR_CLAMP_TO_EDGE_EXT;
+   bool outside = wrap == GL_CLAMP_TO_BORDER || wrap == GL_MIRROR_CLAMP_TO_BORDER_EXT;
+   if (wrap == GL_MIRRORED_REPEAT)
+      s = nir_fsub(b, nir_imm_float(b, 1), nir_fabs(b,
+         nir_fadd_imm(b, nir_fmul_imm(b, nir_ffract(b, nir_fmul_imm(b, s, .5f)), 2), -1)));
+   else if (wrap == GL_MIRROR_CLAMP_EXT || wrap == GL_MIRROR_CLAMP_TO_EDGE_EXT ||
+            wrap == GL_MIRROR_CLAMP_TO_BORDER_EXT)
+      s = nir_fabs(b, s);
+   nir_def *size = nir_imax(b, nir_ushr(b, nir_imm_int(b, width), level),
+                          nir_imm_int(b, 1));
+   if (repeat)
+      s = nir_ffract(b, s);
+   else if (outside)
+      s = nir_fclamp(b, s, nir_imm_float(b, -1), nir_imm_float(b, 2));
+   else
+      s = nir_fsat(b, s); /* GL_CLAMP: clamp before forming filter footprint. */
+   nir_def *u = nir_fmul(b, s, nir_i2f32(b, size));
+   if (!linear) {
+      nir_def *i = nir_f2i32(b, nir_ffloor(b, u));
+      /* NEAREST at clamped s=1 selects the final interior texel. */
+      if (!repeat && !outside)
+         i = nir_imin(b, i, nir_iadd_imm(b, size, -1));
+      return border_fetch(p, unit, level, size, i, repeat, edge);
+   }
+   u = nir_fadd_imm(b, u, -0.5f);
+   nir_def *i = nir_f2i32(b, nir_ffloor(b, u));
+   nir_def *a = border_fetch(p, unit, level, size, i, repeat, edge);
+   nir_def *c = border_fetch(p, unit, level, size, nir_iadd_imm(b, i, 1), repeat, edge);
+   return nir_flrp(b, a, c, nir_ffract(b, u));
+}
