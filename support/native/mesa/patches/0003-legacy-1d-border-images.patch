+static nir_def *
+load_border_texture(struct texenv_fragment_program *p, unsigned unit,
+                    nir_def *coords)
+{
+   nir_builder *b = p->b;
+   GLenum min = p->state->unit[unit].border_min;
+   bool mag_linear = p->state->unit[unit].border_mag == GL_LINEAR;
+   bool min_linear = min == GL_LINEAR || min == GL_LINEAR_MIPMAP_NEAREST ||
+                     min == GL_LINEAR_MIPMAP_LINEAR;
+   bool mip = min != GL_NEAREST && min != GL_LINEAR;
+   bool mip_linear = min == GL_NEAREST_MIPMAP_LINEAR || min == GL_LINEAR_MIPMAP_LINEAR;
+   float crossover = mag_linear &&
+      (min == GL_NEAREST_MIPMAP_NEAREST || min == GL_NEAREST_MIPMAP_LINEAR) ? .5f : 0;
+   nir_def *s = nir_fdiv(b, nir_channel(b, coords, 0), nir_channel(b, coords, 3));
+   nir_def *u = nir_fmul_imm(b, s, p->state->unit[unit].border_width);
+   nir_def *rho = nir_fmax(b, nir_fabs(b, nir_ddx(b, u)), nir_fabs(b, nir_ddy(b, u)));
+   nir_def *lambda = nir_flog2(b, rho);
+   nir_def *mag = border_sample_level(p, unit, s, nir_imm_int(b, 0), mag_linear);
+   nir_def *lod = nir_fclamp(b, lambda, nir_imm_float(b, 0),
+      nir_imm_float(b, p->state->unit[unit].border_max_level));
+   nir_def *lev = mip ? nir_f2i32(b, mip_linear ? nir_ffloor(b, lod) :
+                     nir_fceil(b, nir_fadd_imm(b, lod, -.5f))) : nir_imm_int(b, 0);
+   nir_def *value = border_sample_level(p, unit, s, lev, min_linear);
+   if (mip_linear) {
+      nir_def *next = nir_imin(b, nir_iadd_imm(b, lev, 1),
+                        nir_imm_int(b, p->state->unit[unit].border_max_level));
+      nir_def *other = border_sample_level(p, unit, s, next, min_linear);
+      value = nir_flrp(b, value, other, nir_ffract(b, lod));
+   }
+   BITSET_SET(b->shader->info.textures_used, unit);
+   BITSET_SET(b->shader->info.samplers_used, unit);
+   return nir_bcsel(b, nir_fle_imm(b, lambda, crossover), mag, value);
+}
