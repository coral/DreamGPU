; DreamGPU source-built NT5 display driver. No 3D support yet.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%DreamGPU%
DriverVer=09/11/2026,0.1.0.0

[Manufacturer]
%DreamGPU%=DreamGPUModels

[DreamGPUModels]
%Device%=Dg,PCI\VEN_1234&DEV_1113

[Dg]
CopyFiles=Dg.Miniport,Dg.Display

[Dg.SoftwareSettings]
AddReg=Dg.Settings

[Dg.Settings]
HKR,,InstalledDisplayDrivers,0x00010000,dgpudisp
HKR,,VgaCompatible,0x00010001,1
HKR,,DefaultSettings.XResolution,0x00010001,1024
HKR,,DefaultSettings.YResolution,0x00010001,768
HKR,,DefaultSettings.BitsPerPel,0x00010001,32
HKR,,DefaultSettings.VRefresh,0x00010001,60

[Dg.Services]
AddService=dgpumini,0x00000002,Dg.Service

[Dg.Service]
ServiceType=1
StartType=1
ErrorControl=0
ServiceBinary=%12%\dgpumini.sys
LoadOrderGroup=Video

[DestinationDirs]
Dg.Miniport=12
Dg.Display=11

[Dg.Miniport]
dgpumini.sys

[Dg.Display]
dgpudisp.dll

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
dgpumini.sys=1
dgpudisp.dll=1

[Strings]
DreamGPU="DreamGPU"
Device="DreamGPU"
Disk="DreamGPU driver"
