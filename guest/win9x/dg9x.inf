; Source-built VMDisp9x framebuffer bring-up for DreamGPU's experimental adapter.
[Version]
Signature="$CHICAGO$"
Class=DISPLAY
Provider=%DreamGPU%
DriverVer=09/11/2026,0.1.0.0

[Manufacturer]
%DreamGPU%=Models

[Models]
%Device%=Dg,PCI\VEN_1234&DEV_1113

[Dg]
CopyFiles=DriverFiles
DelReg=PreviousDisplay
AddReg=Settings,Modes

; Match VMDisp9x's migration behavior: inherited VGA CURRENT entries must not
; override the new default mini-VDD/display pair on the next boot.
[PreviousDisplay]
HKR,,Ver
HKR,,DevLoader
HKR,DEFAULT
HKR,MODES
HKR,CURRENT

[DestinationDirs]
DriverFiles=11

[DriverFiles]
dgpumini.drv,,,4
dgpumini.vxd,,,4

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
dgpumini.drv=1
dgpumini.vxd=1

[Settings]
HKR,,Ver,,4.0
HKR,,DevLoader,,*vdd
HKR,DEFAULT,drv,,dgpumini.drv
HKR,DEFAULT,minivdd,,dgpumini.vxd
HKR,DEFAULT,ExtModeSwitch,,0
HKR,DEFAULT,vdd,,*vdd
HKR,DEFAULT,Mode,,"32,1024,768"
HKR,DEFAULT,RefreshRate,,-1
HKR,DEFAULT,DDC,,1

[Modes]
HKR,"MODES\4\640,480",drv,,vga.drv
HKR,"MODES\4\640,480",vdd,,*vdd
HKR,"MODES\8\640,480"
HKR,"MODES\8\800,600"
HKR,"MODES\8\1024,768"
HKR,"MODES\16\640,480"
HKR,"MODES\16\800,600"
HKR,"MODES\16\1024,768"
HKR,"MODES\32\640,480"
HKR,"MODES\32\800,600"
HKR,"MODES\32\1024,768"
HKR,"MODES\32\1280,960"
HKR,"MODES\32\1600,1200"

[Strings]
DreamGPU="DreamGPU"
Device="DreamGPU"
Disk="DreamGPU Win9x driver"
